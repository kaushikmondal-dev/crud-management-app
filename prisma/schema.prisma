// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
    // Target runtime environment. Default: nodejs
    // runtime  = "nodejs"
}

datasource db {
    provider = "sqlite"
}

enum Gender {
    MALE
    FEMALE
    OTHER
}

model UserTable {
    userId     String @id @default(uuid())
    userName   String
    userEmail  String @unique
    userDob    String
    userGender Gender
    userMob    String
}
